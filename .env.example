# --- Storage (Upstash Redis, free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sessions: any long random string, keep it secret ---
AUTH_SECRET=

# --- The first executive account, created on first run ---
ADMIN_USERNAME=your_username
ADMIN_PASSWORD=change-this-before-you-deploy

# --- Lets the Discord bot talk to the site. Any long random string. ---
BOT_API_KEY=
